  },
  "dependencies": {
    "@clarkcant/contracts": "workspace:*",
    "@clarkcant/widget-host": "workspace:*",
    "@clarkcant/widget-sdk": "workspace:*",
    "zod": "4.6.5",
    "@clarkcant/core": "workspace:*",
    "@clarkcant/widget-catalog": "workspace:*",
    "@vitejs/plugin-react": "6.1.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "vite": "8.3.0"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0"
  }
}
