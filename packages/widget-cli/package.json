{
  "name": "@clarkcant/widget-cli",
  "version": "0.1.0",
  "private": true,
  "description": "Widget author CLI: scaffold a package, run the conformance suite, and pack an immutable artifact with a digest.",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "bin": {
    "clark": "./src/cli.ts"
  },
  "clarkcant": {
    "phase": "P6",
