{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "composite": false,
    "declaration": false,
    "declarationMap": false,
    "allowImportingTsExtensions": true,
    "lib": [
      "ES2023",
      "DOM",
      "DOM.Iterable"
    ],
    "jsx": "react-jsx",
    "types": [
      "node"
    ],
    "baseUrl": ".",
    "paths": {
      "@clarkcant/design-tokens": [
        "packages/design-tokens/src/index.ts"
      ],
      "@clarkcant/contracts": [
        "packages/contracts/src/index.ts"
      ],
      "@clarkcant/widget-sdk": [
        "packages/widget-sdk/src/index.ts"
      ],
      "@clarkcant/conversation-client": [
        "packages/conversation-client/src/index.ts"
      ]
    }
  },
  "include": [
    "packages/design-tokens/src/**/*.ts",
    "packages/conversation-client/src/**/*.ts",
    "packages/conversation-client/src/**/*.tsx",
    "packages/conversation-client/test/**/*.ts",
    "packages/conversation-client/test/**/*.tsx",
    "apps/web/src/**/*.ts",
    "apps/web/src/**/*.tsx",
    "apps/web/vite.config.ts",
    "apps/web/e2e/**/*.ts",
    "playwright.config.ts"
  ]
}
