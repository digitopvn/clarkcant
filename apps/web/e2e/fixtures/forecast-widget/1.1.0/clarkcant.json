{
  "schemaVersion": 2,
  "id": "com.acme.forecast",
  "version": "1.1.0",
  "displayName": "Forecast",
  "description": "The week's forecast.",
  "hostApi": {
    "min": 1,
    "max": 1
  },
  "facets": [
    {
      "kind": "ui",
      "id": "com.acme.forecast.week@1",
      "entry": "widgets/week/index.html",
      "definition": "widgets/week/widget.json",
      "isolation": "isolated-ui"
    },
    {
      "kind": "tools",
      "id": "com.acme.forecast.service",
      "entry": "service/server.mjs",
      "isolation": "service",
      "protocol": "mcp-stdio",
      "capabilities": [
        {
          "tool": "week",
          "ref": "com.acme.forecast.week-read@1",
          "summary": "Read the week's forecast",
          "effectCategory": "read"
        }
      ],
      "egress": {
        "version": 1,
        "secrets": [],
        "origins": [
          {
            "origin": "https://forecast.example.com",
            "purpose": "Reads the forecast for the week you look at."
          }
        ]
      }
    }
  ],
  "requestedCapabilities": [],
  "permissions": {
    "networkOrigins": [],
    "filesystem": [],
    "microphone": false,
    "camera": false,
    "lifecycleScripts": []
  },
  "platforms": [
    "darwin-arm64",
    "linux-x64",
    "win32-x64",
    "web"
  ],
  "publisher": {
    "id": "acme",
    "sourceUrl": "https://example.com/acme",
    "license": "MIT"
  }
}