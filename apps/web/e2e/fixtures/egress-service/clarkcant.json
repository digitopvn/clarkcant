{
  "schemaVersion": 2,
  "id": "com.example.lookup",
  "version": "1.0.0",
  "displayName": "Lookup",
  "description": "Looks words up with a provider the node reaches for it, adding the key you gave it.",
  "hostApi": {
    "min": 1,
    "max": 1
  },
  "facets": [
    {
      "kind": "ui",
      "id": "com.example.lookup.panel@1",
      "entry": "widgets/lookup/index.html",
      "definition": "widgets/lookup/widget.json",
      "isolation": "isolated-ui",
      "browserTokens": {
        "version": 1,
        "providers": [
          {
            "provider": "fixture.maps",
            "scopes": ["tiles:read"],
            "purpose": "Draws a map beside the word, with tiles the provider serves to this frame only."
          },
          {
            "provider": "fixture.unscoped",
            "scopes": ["everything"],
            "purpose": "Shows that a provider which cannot narrow a token is refused."
          }
        ]
      }
    },
    {
      "kind": "tools",
      "id": "com.example.lookup.service",
      "entry": "service/server.mjs",
      "isolation": "service",
      "protocol": "mcp-stdio",
      "capabilities": [
        {
          "tool": "define",
          "ref": "com.example.lookup.define@1",
          "summary": "Look a word up with the provider",
          "effectCategory": "read"
        }
      ],
      "egress": {
        "version": 1,
        "secrets": [
          {
            "name": "LOOKUP_API_KEY",
            "purpose": "Signs the lookups in with the provider."
          }
        ],
        "origins": [
          {
            "origin": "http://127.0.0.1:8879",
            "purpose": "Looks up the words you ask about.",
            "credential": {
              "secret": "LOOKUP_API_KEY",
              "header": "authorization",
              "scheme": "bearer"
            }
          }
        ]
      }
    }
  ],
  "requestedCapabilities": [],
  "permissions": {
    "networkOrigins": [],
    "filesystem": [],
    "microphone": false,
    "camera": false,
    "lifecycleScripts": []
  },
  "platforms": [
    "darwin-arm64",
    "linux-x64",
    "win32-x64",
    "web"
  ],
  "resources": {
    "version": 1,
    "profile": "interactive-heavy"
  },
  "publisher": {
    "id": "example",
    "sourceUrl": "https://example.com",
    "license": "MIT"
  },
  "dependencies": []
}
