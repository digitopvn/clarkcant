{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "summary": {
      "type": "string",
      "minLength": 1,
      "maxLength": 600
    },
    "selectedIds": {
      "maxItems": 64,
      "type": "array",
      "items": {
        "type": "string",
        "maxLength": 200
      }
    },
    "values": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "maxLength": 80
      },
      "additionalProperties": {
        "anyOf": [
          {
            "type": "string",
            "maxLength": 600
          },
          {
            "type": "number"
          },
          {
            "type": "boolean"
          },
          {
            "maxItems": 64,
            "type": "array",
            "items": {
              "type": "string",
              "maxLength": 600
            }
          }
        ]
      }
    }
  },
  "required": [
    "summary"
  ],
  "additionalProperties": false
}
