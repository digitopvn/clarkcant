{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "status": {
          "type": "string",
          "const": "done"
        },
        "output": {
          "type": "string",
          "maxLength": 4000
        }
      },
      "required": [
        "status"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "status": {
          "type": "string",
          "const": "refused"
        },
        "by": {
          "type": "string",
          "enum": [
            "page",
            "widget"
          ]
        },
        "code": {
          "type": "string",
          "minLength": 1,
          "maxLength": 60
        },
        "message": {
          "type": "string",
          "minLength": 1,
          "maxLength": 600
        }
      },
      "required": [
        "status",
        "by",
        "code",
        "message"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "status": {
          "type": "string",
          "const": "no-answer"
        },
        "message": {
          "type": "string",
          "minLength": 1,
          "maxLength": 600
        }
      },
      "required": [
        "status",
        "message"
      ],
      "additionalProperties": false
    }
  ]
}
