{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "v": {
      "type": "number",
      "const": 1
    },
    "performId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9_-]+$"
    },
    "instanceId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "actionBindingId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "action": {
      "type": "string",
      "pattern": "^[a-z][A-Za-z0-9._-]{0,63}$"
    },
    "input": {
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {}
    }
  },
  "required": [
    "v",
    "performId",
    "instanceId",
    "actionBindingId",
    "action",
    "input"
  ],
  "additionalProperties": false
}
