# Copy to `.env` and fill in. Never commit the filled copy: `.env` is ignored, this file is not.
#
# The node reads `.env` at startup and a variable already present in its environment always
# wins, so a deployment that sets these itself does not need this file at all. Only the variable
# names are ever written to the log — never a value.

# ---------------------------------------------------------------------------
# Which model answers conversations
# ---------------------------------------------------------------------------
# Both are required together. A provider without a model is a half-configured node and the
# node says so rather than substituting a model nobody chose; with neither set, the node
# answers from scripted recipes and installed capabilities only, and calls no provider.
#
# The node refuses an unknown provider or model by name, listing what the catalogue does have,
# so a typo is reported where it is made rather than at the first turn.
CC_MODEL_PROVIDER=deepseek
CC_MODEL_ID=deepseek-v4-flash
# Optional. One of: off, minimal, low, medium, high, xhigh, max. Anything else is ignored
# rather than passed on.
# CC_MODEL_THINKING=low

# ---------------------------------------------------------------------------
# Ceiling on one conversation turn
# ---------------------------------------------------------------------------
# A conversation is the path with no approval step in front of it, so it is the one that needs
# a ceiling: every message is a provider call the user pays for, and a model that loops would
# otherwise do so until somebody noticed. The defaults are deliberately generous, because a
# limit that fires on ordinary use teaches the user to raise it rather than to trust it.
#
# A value that is not a positive number is ignored, not clamped: silently turning a mistyped
# limit into a different limit would leave an operator believing a restriction is in force.
# CC_MODEL_MAX_WALL_CLOCK_MS=120000
# CC_MODEL_MAX_TOKENS=32000

# ---------------------------------------------------------------------------
# Provider credentials
# ---------------------------------------------------------------------------
# Supply the key for whichever provider CC_MODEL_PROVIDER names. A node with no key for its
# configured provider starts and reports that the model is not reachable, rather than failing
# to start — an operator should be able to see the node and read why.
DEEPSEEK_API_KEY=
GEMINI_API_KEY=
OPENAI_API_KEY=
OPENROUTER_API_KEY=

# ---------------------------------------------------------------------------
# Other integrations
# ---------------------------------------------------------------------------
# Optional. Only the capabilities you install will read them.
ELEVENLABS_API_KEY=
MINIMAX_API_KEY=
LEONARDO_API_KEY=
GH_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_R2_ACCESS_KEY=
CLOUDFLARE_R2_SECRET=
CLOUDFLARE_R2_TOKEN=
CLOUDFLARE_R2_S3_ENDPOINT=
